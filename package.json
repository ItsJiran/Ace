{
  "name": "AceAssistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "env VITE_ACE_RUNTIME_MODE=desktop vite --strictPort",
    "dev:electron:main": "env ACE_RUNTIME_MODE=desktop nodemon --watch electron --ext cjs --signal SIGTERM --exec \"electron .\"",
    "dev:electron": "concurrently -k \"npm run dev:vite -- --host 127.0.0.1 --port 5173\" \"wait-on tcp:5173 && npm run dev:electron:main\"",
    "start:electron": "npm run build:vite && env ACE_RUNTIME_MODE=desktop ACE_ELECTRON_FORCE_PROD=true electron . --no-sandbox",
    "build:vite": "tsc -b && vite build",
    "build:electron": "npm run build:vite && electron-builder",
    "dev:background": "env ACE_RUNTIME_MODE=background node --watch --import tsx --loader ./scripts/background-alias-loader.mjs src/app-background/main.ts",
    "start:background": "env ACE_RUNTIME_MODE=background node --import tsx --loader ./scripts/background-alias-loader.mjs src/app-background/main.ts",
    "dev:desktop": "npm run dev:electron",
    "dev": "npm run dev:desktop",
    "dev:perf": "env VITE_PERF_LOG=true npm run dev:desktop",
    "start": "npm run start:electron",
    "build": "npm run build:electron",
    "build:web": "node scripts/build-web.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "install-package": "node scripts/install-package.js"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.46",
    "@langchain/google": "^0.1.12",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.6",
    "@langchain/quickjs": "^0.4.0",
    "@langchain/react": "^1.0.4",
    "@langchain/tavily": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepagents": "^1.10.2",
    "duck-duck-scrape": "^2.2.7",
    "fix-path": "^5.0.0",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "langchain": "^1.4.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sherpa-onnx": "^1.13.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.3",
    "uiohook-napi": "^1.5.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.5.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.8",
    "recharts": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.6"
  },
  "overrides": {
    "zod": "$zod"
  },
  "build": {
    "appId": "com.ace.assistant.electron",
    "productName": "ACE",
    "asarUnpack": [
      "node_modules/tsx/**/*",
      "node_modules/esbuild/**/*",
      "node_modules/@esbuild/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/background-alias-loader.mjs",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public"
    },
    "linux": {
      "icon": "public",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
