{
  "name": "ace-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup:gateway": "python3 -m venv src-gateway-server/.venv && src-gateway-server/.venv/bin/pip install -r src-gateway-server/requirements.txt",
    "dev:vite": "vite",
    "dev:gateway": "src-gateway-server/.venv/bin/python src-gateway-server/main.py",
    "dev:with-gateway": "sh -c 'src-gateway-server/.venv/bin/python src-gateway-server/main.py & GATEWAY_PID=$!; trap \"kill $GATEWAY_PID\" EXIT; npm run dev'",
    "build:vite": "tsc -b && vite build",
    "dev": "env -u GTK_PATH -u GIO_MODULE_DIR -u GDK_PIXBUF_MODULEDIR -u GDK_PIXBUF_MODULE_FILE -u LD_LIBRARY_PATH PATH=$HOME/.cargo/bin:$PATH tauri dev",
    "dev:perf": "env VITE_PERF_LOG=true npm run dev",
    "build": "env -u GTK_PATH -u GIO_MODULE_DIR -u GDK_PIXBUF_MODULEDIR -u GDK_PIXBUF_MODULE_FILE -u LD_LIBRARY_PATH PATH=$HOME/.cargo/bin:$PATH tauri build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "install-package": "node scripts/install-package.js"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "xcap": "^1.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.8",
    "recharts": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
